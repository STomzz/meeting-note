# 部署环境变量（复制到 /etc/bnu-meeting-api/env）
# 上游 = BNUAPI 公网入口（与 App 用户填写的一致；同机也可改 127.0.0.1:3000）
MMA_UPSTREAM_BASE_URL=https://chatapi.bnu.edu.cn/v1
# 客户端可通过 X-Upstream-Base-URL 覆盖上游；主机白名单（逗号分隔，空=不限制；. 开头 = 域名后缀）
MMA_UPSTREAM_ALLOWED_HOSTS=chatapi.bnu.edu.cn,.bnu.edu.cn

# 兜底服务端 key：留空则必须由客户端携带自己的 BNUAPI key
MMA_UPSTREAM_API_KEY=
MMA_ALLOW_SERVER_KEY=true

MMA_LOG_LEVEL=INFO
MMA_DEFAULT_ASR_MODEL=qwen3-asr-1.7b
MMA_DEFAULT_MINUTES_MODEL=Qwen-Inno-35B-v1
MMA_MAX_AUDIO_MB=50
