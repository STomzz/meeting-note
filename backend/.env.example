# BNU 会议纪要后端配置（所有变量前缀 MMA_）
# 复制为 .env 后按需修改；不改也能跑（默认指向同机 BNUAPI）

# --- 服务 ---
MMA_HOST=0.0.0.0
MMA_PORT=8000
MMA_LOG_LEVEL=INFO

# --- 上游（OpenAI 兼容网关）---
# 默认走 BNUAPI 公网入口；同机部署也可改成 http://127.0.0.1:3000/v1
MMA_UPSTREAM_BASE_URL=https://chatapi.bnu.edu.cn/v1
# 客户端可通过 X-Upstream-Base-URL 覆盖上游地址；主机白名单（逗号分隔，空=不限制）
MMA_UPSTREAM_ALLOWED_HOSTS=chatapi.bnu.edu.cn
# 兜底服务端 key（仅开发/联调用；生产让 App 传自己的 key）
MMA_UPSTREAM_API_KEY=
MMA_ALLOW_SERVER_KEY=true
MMA_UPSTREAM_TIMEOUT_S=300
MMA_UPSTREAM_CONNECT_TIMEOUT_S=10
MMA_UPSTREAM_MAX_RETRIES=2

# --- 默认模型（App 可逐请求覆盖）---
MMA_DEFAULT_ASR_MODEL=qwen3-asr-1.7b
MMA_DEFAULT_MINUTES_MODEL=Qwen-Inno-35B-v1
MMA_MINUTES_TEMPERATURE=0.2
MMA_MINUTES_MAX_TOKENS=8192
MMA_USE_JSON_RESPONSE_FORMAT=true
# 长会议走 map-reduce 的阈值与分段字数
MMA_MINUTES_MAP_REDUCE_THRESHOLD_CHARS=60000
MMA_MINUTES_CHUNK_CHARS=20000

# --- 限制 ---
MMA_MAX_AUDIO_MB=50
MMA_MAX_TRANSCRIPT_CHARS=1500000

# --- 音频转码（默认关闭；开启需系统有 ffmpeg）---
MMA_TRANSCODE_ENABLED=false
MMA_FFMPEG_BIN=ffmpeg
